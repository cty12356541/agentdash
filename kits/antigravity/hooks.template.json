{
  "agentdash": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "agentdash hook --host agy pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agentdash hook --host agy posttooluse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agentdash hook --host agy stop"
      }
    ]
  }
}
