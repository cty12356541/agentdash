{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {"type": "command",
           "command": "agentdash hook posttooluse || true"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {"type": "command",
           "command": "agentdash hook pretooluse || true"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command",
           "command": "agentdash hook stop || true"}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command",
           "command": "agentdash hook subagentstop || true"}
        ]
      }
    ]
  }
}
